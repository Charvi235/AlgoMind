# Copy this file to .env and fill in the real values.
# .env is git-ignored; .env.example is committed and kept up to date.

# Port the Express server listens on (default: 5000)
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Secret used to sign and verify JWT tokens — must be a long random string
JWT_SECRET=replace_with_a_long_random_secret

# Allowed CORS origin for the frontend (required in production, optional in dev)
CLIENT_URL=http://localhost:5173

# Runtime environment — set to "production" on the deployed server
NODE_ENV=development

# Brevo (Sendinblue) transactional email — required in production for OTP emails
BREVO_API_KEY=xkeysib-replace-with-real-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=AlgoMind

# Number of reverse-proxy hops to trust when reading X-Forwarded-For
# (0 = no proxy / local dev; 1 = one proxy, e.g. Render or Vercel)
TRUST_PROXY_HOPS=0

# Set to "1" to expose GET /api/debug/ip for measuring the correct TRUST_PROXY_HOPS
# Remove or leave blank in production
DEBUG_IP=
